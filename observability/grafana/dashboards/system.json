{
  "annotations": { "list": [] },
  "editable": true,
  "title": "AegisForge System",
  "uid": "aegisforge-system",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{status}}"
        }
      ]
    },
    {
      "title": "API Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "title": "LLM Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(llm_request_duration_seconds_sum[5m]) / rate(llm_request_duration_seconds_count[5m])",
          "legendFormat": "avg latency"
        }
      ]
    },
    {
      "title": "LLM Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(llm_requests_total{status=\"error\"}[5m])",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "title": "Workflow Success Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(workflow_runs_total{status=\"completed\"}) / sum(workflow_runs_total) * 100",
          "legendFormat": "success %"
        }
      ]
    },
    {
      "title": "Tool Execution Count",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(tool_executions_total)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "title": "Retry Count",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum(workflow_retries_total)",
          "legendFormat": "retries"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s"
}
