# AegisForge Environment Variables
# Copy this file to .env and fill in values.

# --- Application ---
APP_NAME=aegisforge
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg://aegisforge:aegisforge@localhost:5432/aegisforge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider ---
# Options: deterministic, openai, anthropic
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings ---
# Options: deterministic, openai
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Document Ingestion ---
MAX_DOCUMENT_SIZE_BYTES=10485760
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- MCP ---
MCP_ENABLED=false
MCP_TIMEOUT_SECONDS=30

# --- Async Execution ---
JOB_QUEUE_ENABLED=false
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=300

# --- Approval ---
APPROVAL_REQUIRED_RISK_LEVELS=high,critical
APPROVAL_TIMEOUT_HOURS=24
