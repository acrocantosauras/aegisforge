# AegisForge Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env with real secrets.

# --- Application ---
APP_NAME=aegisforge
ENVIRONMENT=development       # development | test | production
DEBUG=false
# REQUIRED in production: the app REFUSES TO START if this placeholder (or any
# key < 32 chars) is used while ENVIRONMENT=production. Generate a real key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1

# --- Database ---
# Production: use PostgreSQL with pgvector
DATABASE_URL=postgresql+psycopg://aegisforge:aegisforge@localhost:5432/aegisforge

# --- Redis ---
# Password used by docker-compose for the Redis container (requirepass).
# MUST be overridden with a strong value in production.
REDIS_PASSWORD=change-me-in-production
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider ---
# Options: deterministic, openai, anthropic
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=                    # REQUIRED for non-deterministic providers
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings ---
# Options: deterministic, openai
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=              # REQUIRED for non-deterministic providers
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Document Ingestion ---
MAX_DOCUMENT_SIZE_BYTES=10485760
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- MCP ---
MCP_ENABLED=false
MCP_TIMEOUT_SECONDS=30

# --- Async Execution ---
JOB_QUEUE_ENABLED=false
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=300

# --- Approval ---
APPROVAL_REQUIRED_RISK_LEVELS=high,critical
APPROVAL_TIMEOUT_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins. For production, set to your frontend URL.
CORS_ORIGINS=http://localhost:3000

# --- Rate Limiting ---
# STRONGLY recommended: true in production (Redis-backed, per-user/IP).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Observability (optional) ---
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# Production deployment (docker-compose.prod.yml)
# ============================================================
# Used by the production stack; all values REQUIRED unless noted.

# Bundled Postgres credentials (skip when using managed DATABASE_URL).
POSTGRES_USER=aegisforge
POSTGRES_DB=aegisforge
POSTGRES_PASSWORD=change-me-in-production

# Caddy HTTPS domains (must resolve publicly for automatic Let's Encrypt).
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Browser-reachable API origin, baked into the frontend bundle at build time.
NEXT_PUBLIC_API_URL=https://api.example.com

# CORS_ORIGINS above must be the browser frontend origin, e.g. https://app.example.com
